# =====================================================================
# dextea-trade 环境变量配置模板
# ---------------------------------------------------------------------
# 本文件列出服务【所有】可配置项。复制为 .env 后填入真实值即可：
#     cp .env.example .env
#     java -jar target/dextea-trade-0.0.1-SNAPSHOT.jar --env-file=.env
#
# 两种配置注入方式（二选一或组合）：
#   1) 环境变量（本文件）：Spring 宽松绑定 ALIPAY_* → alipay.* 等，容器/K8s 注入最方便。
#   2) Nacos（可选）：在 dextea-trade.yaml 中以相同结构（spring.datasource.*、redis.*、
#      alipay.* 等）下发，会覆盖同名环境变量；未下发的配置仍回退到本文件/默认值。
#      详见 docs/Nacos.md。
#
# 约定：
#   - 标记为「必填」的项缺省值仅适用于本地 Demo，生产务必修改。
#   - 「使用支付宝时必填」：不需要支付宝支付可全部留空，服务照常启动。
#   - 敏感信息（密码、私钥）勿提交；私钥/公钥多行内容必须用双引号包裹。
#   - 生产环境务必清空 ALIPAY_FORCE_AMOUNT（其默认 0.01 会覆盖真实金额，仅用于开发）。
# =====================================================================

# ===== 服务 =====
SERVER_PORT=9090
SPRING_APPLICATION_NAME=dextea-trade

# ===== 数据库（必填）=====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dextea
DB_USERNAME=root
DB_PASSWORD=root

# ===== Redis（必填）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Nacos（可选，配置中心）=====
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_CONFIG_GROUP=DEFAULT_GROUP

# ===== 支付宝（需要支付宝支付时必填 APP_ID/PRIVATE_KEY/PUBLIC_KEY，其余可选）=====
# 对应 application.yaml 的 alipay.* 配置块
ALIPAY_OPENAPI_GATEWAY=https://openapi.alipay.com
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SUBJECT=德贤茶庄订单
ALIPAY_PRODUCT_CODE=JSAPI_PAY
# 开发环境固定订单金额为 0.01 元避免真实扣款；生产环境置空改用真实金额
ALIPAY_FORCE_AMOUNT=0.01
# 异步回调地址，留空则不设置；非空时创建交易传给支付宝
ALIPAY_NOTIFY_URL=

# ===== CosId（分布式 ID，一般无需改）=====
COSID_NAMESPACE=dextea-trade
COSID_MACHINE_ENABLED=true
COSID_MACHINE_DISTRIBUTOR_TYPE=redis
COSID_SNOWFLAKE_ENABLED=true
COSID_SNOWFLAKE_PROVIDER_ORDER_NAMESPACE=dextea-trade
