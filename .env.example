# ===== 服务 =====
SERVER_PORT=9090
SPRING_APPLICATION_NAME=dextea-trade

# ===== 数据库（必填）=====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dextea
DB_USERNAME=root
DB_PASSWORD=root

# ===== Redis（必填）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Nacos（可选，配置中心）=====
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_CONFIG_GROUP=DEFAULT_GROUP

# ===== 支付宝（可选，不用支付则不填）=====
ALIPAY_GATEWAY=https://openapi.alipay.com
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SUBJECT=德贤茶庄订单
ALIPAY_PRODUCT_CODE=JSAPI_PAY
# 开发环境固定订单金额为 0.01 元避免真实扣款；生产环境置空改用真实金额
ALIPAY_FORCE_AMOUNT=0.01
# 异步回调地址，留空则不设置；非空时创建交易传给支付宝
ALIPAY_NOTIFY_URL=

# ===== CosId（分布式 ID，一般无需改）=====
COSID_NAMESPACE=dextea-trade
COSID_MACHINE_ENABLED=true
COSID_MACHINE_DISTRIBUTOR_TYPE=redis
COSID_SNOWFLAKE_ENABLED=true
COSID_SNOWFLAKE_PROVIDER_ORDER_NAMESPACE=dextea-trade
