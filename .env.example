# ===== 服务（选填）=====
# 服务端口
# SERVER_PORT=9090
# 应用名称
# SPRING_APPLICATION_NAME=dextea-trade

# ===== MySQL =====
# 数据库主机地址
# DB_HOST=localhost
# 数据库端口
# DB_PORT=3306
# 数据库名称
# DB_NAME=dextea
# 数据库用户名
# DB_USERNAME=root
# 数据库密码
# DB_PASSWORD=root

# ===== Redis =====
# Redis 主机地址
# REDIS_HOST=localhost
# Redis 端口
# REDIS_PORT=6379
# Redis 密码
# REDIS_PASSWORD=

# ===== Nacos（必填，服务注册与发现，注册失败则启动失败）=====
# Nacos 服务器地址
# NACOS_SERVER_ADDR=127.0.0.1:8848
# Nacos 命名空间（留空为 public）
# NACOS_NAMESPACE=
# Nacos 用户名（与密码成对配置）
# NACOS_USERNAME=
# Nacos 密码
# NACOS_PASSWORD=
# 服务注册分组
# NACOS_DISCOVERY_GROUP=DEFAULT_GROUP
# 注册集群名
# NACOS_DISCOVERY_CLUSTER=DEFAULT
# 注册到 Nacos 的本机 IP（留空自动探测）
# NACOS_DISCOVERY_IP=

# ===== 支付宝 =====
# 支付宝应用 ID
ALIPAY_APP_ID=
# 支付宝应用私钥
ALIPAY_PRIVATE_KEY=
# 支付宝公钥
ALIPAY_PUBLIC_KEY=
# 商品标题
# ALIPAY_SUBJECT=dextea-order
# 支付宝网关地址
# ALIPAY_GATEWAY=https://openapi.alipay.com
# 固定订单金额（开发环境固定订单金额，生产环境置空改用真实金额）
# ALIPAY_FORCE_AMOUNT=
# 异步回调地址（必填，留空则不设置）
ALIPAY_NOTIFY_URL=

# ===== 支付回调 MQ =====
# 是否启用支付回调 MQ
# PAYMENT_CALLBACK_MQ_ENABLED=true
# 支付回调 MQ 接入点
PAYMENT_CALLBACK_MQ_ENDPOINTS=
# 支付回调 MQ 命名空间（实例 ID，阿里云）
# PAYMENT_CALLBACK_MQ_NAMESPACE=
# 支付回调 MQ 访问用户名
# PAYMENT_CALLBACK_MQ_ACCESS_KEY=
# 支付回调 MQ 访问密码
# PAYMENT_CALLBACK_MQ_SECRET_KEY=
# 支付回调 MQ 主题
PAYMENT_CALLBACK_MQ_TOPIC=
# 支付回调 MQ 消费组
PAYMENT_CALLBACK_MQ_CONSUMER_GROUP=
# 支付回调 MQ 标签（默认 * 表示订阅所有 Tag）
# PAYMENT_CALLBACK_MQ_TAG=*

# ===== 制单 MQ =====
# 是否启用制单 MQ
# ORDER_MAKING_MQ_ENABLED=true
# 制单 MQ 接入点
ORDER_MAKING_MQ_ENDPOINTS=
# 制单 MQ 命名空间（实例 ID，阿里云）
# ORDER_MAKING_MQ_NAMESPACE=
# 制单 MQ 访问用户名
# ORDER_MAKING_MQ_ACCESS_KEY=
# 制单 MQ 访问密码
# ORDER_MAKING_MQ_SECRET_KEY=
# 制单 MQ 主题
ORDER_MAKING_MQ_TOPIC=

# ===== 订单超时 MQ =====
# 是否启用订单超时 MQ（启用后生产者和消费者同时开启）
# ORDER_TIMEOUT_MQ_ENABLED=true
# 订单超时 MQ 接入点
ORDER_TIMEOUT_MQ_ENDPOINTS=
# 订单超时 MQ 命名空间（实例 ID，阿里云）
# ORDER_TIMEOUT_MQ_NAMESPACE=
# 订单超时 MQ 访问用户名
# ORDER_TIMEOUT_MQ_ACCESS_KEY=
# 订单超时 MQ 访问密码
# ORDER_TIMEOUT_MQ_SECRET_KEY=
# 订单超时 MQ 主题
ORDER_TIMEOUT_MQ_TOPIC=
# 订单超时 MQ 消费组
ORDER_TIMEOUT_MQ_CONSUMER_GROUP=
# 订单超时 MQ 延迟分钟数
# ORDER_TIMEOUT_MQ_DELAY_MINUTES=16

# ===== CosId =====
# CosId 命名空间
# COSID_NAMESPACE=dextea-trade
# 是否启用机器号分配
# COSID_MACHINE_ENABLED=true
# 机器号分配器类型
# COSID_MACHINE_DISTRIBUTOR_TYPE=redis
# 是否启用雪花算法
# COSID_SNOWFLAKE_ENABLED=true
# 订单雪花命名空间
# COSID_SNOWFLAKE_PROVIDER_ORDER_NAMESPACE=dextea-trade

# ===== 订单 =====
# 支付超时 TTL（分钟）
# ORDER_PAYMENT_TTL=15
# 幂等键 TTL（分钟）
# ORDER_CREATE_ORDER_IDEM_TTL=1440
# 订单项缓存 TTL（分钟），订单制作 2h 内结束，默认 120
# ORDER_ITEM_CACHE_TTL=120

# ===== OpenTelemetry =====
# 是否启用 OpenTelemetry
OTEL_ENABLED=true
# Trace 上报地址（信号级完整地址：通用地址 OTEL_EXPORTER_OTLP_ENDPOINT 会被 SDK 追加 /v1/traces，
# 与阿里云 ARMS 等平台的路径不符，推荐按信号单独指定完整地址）
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# 指标上报地址
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# 上报协议：http/protobuf 或 grpc
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# 资源属性（服务名/版本/环境），逗号分隔
OTEL_RESOURCE_ATTRIBUTES=service.name=dextea-trade,service.version=0.0.1-SNAPSHOT,deployment.environment=prod
# Trace 导出器（otlp 上报 / none 关闭）
# OTEL_TRACES_EXPORTER=otlp
# 日志导出器（SDK 默认 otlp；项目未接日志桥接器时无实际导出，建议显式置 none）
# OTEL_LOGS_EXPORTER=none
# 指标导出器
# OTEL_METRICS_EXPORTER=otlp
