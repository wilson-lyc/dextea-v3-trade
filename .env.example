# ===== 服务 =====
# 服务端口
# SERVER_PORT=9090
# 应用名称
# SPRING_APPLICATION_NAME=dextea-trade

# ===== 鉴权 =====
# 是否开启令牌鉴权
# AUTH_ENABLED=true
# 合法 API 令牌列表（逗号分隔，命中其一即可通过校验）
# AUTH_TOKENS=

# ===== MySQL =====
# 数据库主机地址
DB_HOST=
# 数据库端口
DB_PORT=
# 数据库名称
DB_NAME=
# 数据库用户名
DB_USERNAME=
# 数据库密码
DB_PASSWORD=

# ===== Redis =====
# Redis 主机地址
REDIS_HOST=
# Redis 端口
REDIS_PORT=
# Redis 密码（无密码留空）
REDIS_PASSWORD=
# Redis 数据库编号
# REDIS_DATABASE=0

# ===== Nacos =====
# 本文件仅作为变量清单；运行 Trade 时请在 IDEA Run Configuration 或部署环境中注入变量。
# 是否启用服务注册与发现
# NACOS_ENABLED=true
# Nacos 服务器地址
NACOS_SERVER_ADDR=127.0.0.1:8848
# Nacos 命名空间（留空为 public）
# NACOS_NAMESPACE=
# Nacos 用户名（与密码成对配置）
# NACOS_USERNAME=
# Nacos 密码
# NACOS_PASSWORD=
# 服务注册分组
# NACOS_GROUP=DEFAULT_GROUP
# 注册集群名
# NACOS_CLUSTER=DEFAULT
# 注册到 Nacos 的本机 IP（留空自动探测）
# NACOS_INSTANCE_IP=
# 注册服务名（默认使用 SPRING_APPLICATION_NAME）
# NACOS_SERVICE_NAME=dextea-trade

# ===== 支付宝 =====
# 支付宝应用 ID
ALIPAY_APP_ID=
# 支付宝应用私钥
ALIPAY_PRIVATE_KEY=
# 支付宝公钥
ALIPAY_PUBLIC_KEY=
# 商品标题
# ALIPAY_SUBJECT=dextea-order
# 支付宝网关地址
# ALIPAY_GATEWAY=https://openapi.alipay.com
# 固定订单金额（开发环境固定订单金额，生产环境置空改用真实金额）
# ALIPAY_FORCE_AMOUNT=
# 异步回调地址（必填，留空则不设置）
# ALIPAY_NOTIFY_URL=

# ===== RocketMQ =====
# MQ 总开关（关闭后所有队列的生产者与消费者均不启动）
# ROCKETMQ_ENABLED=true
# MQ 接入点
ROCKETMQ_ENDPOINTS=
# MQ 命名空间（实例 ID，阿里云）
# ROCKETMQ_NAMESPACE=
# MQ 访问用户名
# ROCKETMQ_ACCESS_KEY=
# MQ 访问密码
# ROCKETMQ_SECRET_KEY=

# --- 支付回调 MQ ---
# 是否启用支付回调 MQ（默认关闭）
# PAYMENT_CALLBACK_MQ_ENABLED=false
# 支付回调 MQ 主题
# PAYMENT_CALLBACK_MQ_TOPIC=payment_callback
# 支付回调 MQ 消费组
# PAYMENT_CALLBACK_MQ_CONSUMER_GROUP=payment_callback
# 支付回调 MQ 标签（默认 * 表示订阅所有 Tag）
# PAYMENT_CALLBACK_MQ_TAG=*

# --- 制单 MQ ---
# 是否启用制单 MQ（默认关闭）
# ORDER_MAKING_MQ_ENABLED=false
# 制单 MQ 主题
# ORDER_MAKING_MQ_TOPIC=order_making_status

# --- 订单超时 MQ ---
# 是否启用订单超时 MQ（启用后生产者和消费者同时开启，默认关闭）
# ORDER_TIMEOUT_MQ_ENABLED=false
# 订单超时 MQ 主题
# ORDER_TIMEOUT_MQ_TOPIC=order_timeout
# 订单超时 MQ 消费组
# ORDER_TIMEOUT_MQ_CONSUMER_GROUP=order_timeout
# 订单超时 MQ 延迟分钟数
# ORDER_TIMEOUT_MQ_DELAY_MINUTES=16

# ===== CosId =====
# CosId 命名空间
# COSID_NAMESPACE=dextea-trade
# 是否启用机器号分配
# COSID_MACHINE_ENABLED=true
# 机器号分配器类型
# COSID_MACHINE_DISTRIBUTOR_TYPE=redis
# 是否启用雪花算法
# COSID_SNOWFLAKE_ENABLED=true
# 订单雪花命名空间
# COSID_SNOWFLAKE_PROVIDER_ORDER_NAMESPACE=dextea-trade

# ===== 订单 =====
# 支付超时 TTL（分钟）
# ORDER_PAYMENT_TTL=15
# 幂等键 TTL（分钟）
# ORDER_CREATE_ORDER_IDEM_TTL=1440
# 订单项缓存 TTL（分钟），订单制作 2h 内结束，默认 120
# ORDER_ITEM_CACHE_TTL=120
